generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String
  color       String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model PortfolioItem {
  id          String           @id @default(cuid())
  title       String
  description String
  thumbnail   String
  type        String           @default("PROJECT")
  embedUrl    String?
  slug        String           @unique
  published   Boolean          @default(false)
  order       Int              @default(0)
  projectDate DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  media       PortfolioMedia[]
  blocks      ContentBlock[]

  @@index([published, order])
  @@index([slug])
}

model PortfolioMedia {
  id              String        @id @default(cuid())
  portfolioItemId String
  portfolioItem   PortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)
  type            String
  url             String
  caption         String?
  order           Int           @default(0)
  createdAt       DateTime      @default(now())

  @@index([portfolioItemId, order])
}

model ContentBlock {
  id              String        @id @default(cuid())
  portfolioItemId String
  portfolioItem   PortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)
  type            String
  order           Int           @default(0)
  content         String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([portfolioItemId, order])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

/// Een bedrijf dat je benadert: bedrijfsgegevens plus verkoopadministratie.
///
/// De demopagina zelf staat NIET hier, maar als los bestand in demos/<slug>.html.
/// Elke demo is een eigen ontwerp en geen ingevuld sjabloon — twintig identieke
/// pagina's in dezelfde regio verraden meteen dat het massawerk is, en dan
/// verwacht de klant ook een sjabloonsite voor zijn geld. Als bestand in git
/// kan een demo bovendien nooit kwijtraken en is elke versie terug te halen.
model Prospect {
  id   String @id @default(cuid())
  /// Wordt de URL: /demo/<slug>
  slug String @unique

  // --- Bedrijfsgegevens ---
  bedrijf     String
  branche     String
  plaats      String
  regio       String
  huidigeSite String?

  // --- Contactpersoon ---
  contact  String?
  email    String?
  telefoon String?

  // --- Verkoopadministratie ---
  /// NIEUW | DEMO_KLAAR | GEMAILD | BEKEKEN | GEREAGEERD | GESPREK | KLANT | AFGEWEZEN
  status       String    @default("NIEUW")
  /// BASIS | COMPLEET | MAATWERK
  pakket       String?
  bedrag       Int?
  perMaand     Int?
  gemaildOp    DateTime?
  opgevolgdOp  DateTime?
  gereageerdOp DateTime?
  notitie      String?

  // --- De demopagina ---
  /// Staat de link aan? De pagina zelf komt uit demos/<slug>.html.
  gepubliceerd Boolean @default(false)

  // --- De verkoopbalk onderaan de demo ---
  pitchActief   Boolean @default(true)
  pitchPrijs    Int     @default(750)
  pitchPerMaand Int     @default(20)

  weergaves DemoWeergave[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
}

/// Elke keer dat iemand een demopagina opent. Wie zijn demo bekijkt en niet
/// reageert, is degene die je moet bellen — dat is de hoogste conversie die er is.
model DemoWeergave {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  bekekenOp  DateTime @default(now())
  ip         String?
  browser    String?
  verwijzer  String?

  @@index([prospectId, bekekenOp])
}
